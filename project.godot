; Development host project for the INVO Network Godot addon.
; The shippable artifact is addons/invonetwork/ — this project exists to
; develop and test it. Ship the addon folder, not this project.

config_version=5

[application]

config/name="INVO Network Godot SDK (dev host)"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=1

[editor_plugins]

enabled=PackedStringArray("res://addons/invonetwork/plugin.cfg")
