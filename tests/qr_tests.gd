extends SceneTree
## Headless tests for InvoQr (the wallet's phone-approval QR encoder).
## Run from the addon dev-host project:
##   godot --headless --script res://tests/qr_tests.gd
## Exit code 0 = all passed.
##
## The reference matrices at the bottom were generated independently with
## Nayuki's qrcodegen (Python), which picks its mask with the same penalty
## rules, and cross-checked bit-for-bit against python-qrcode and segno forced
## to the same mask (segno 1.6.6 needed a patch: it writes a spurious 0x00
## codeword when the bit stream is already byte-aligned).

const _URL: String = "https://invo.network/approve?c=ABCD-EFGH&s=7f3a9c2e1b4d6f8a0c2e4f6a8b0d2c4e&g=space-miners-deluxe&amt=4.99&cur=USD&exp=1761600000"
## "Café ☕ 🎮 approve" (2-, 3- and 4-byte UTF-8 sequences).
const _UTF8: String = "Café ☕ \U01F3AE approve"
const _CASES: Dictionary = {
	"short": "INVO",
	"url": _URL,
	"one": "A",
	"utf8": _UTF8,
}
## Max byte-mode payload per version 1-15 (ISO/IEC 18004 Table 7), per level.
const _BYTE_CAPACITY: Dictionary = {
	"L": [17, 32, 53, 78, 106, 134, 154, 192, 230, 271, 321, 367, 425, 458, 520],
	"M": [14, 26, 42, 62, 84, 106, 122, 152, 180, 213, 251, 287, 331, 362, 412],
	"Q": [11, 20, 32, 46, 60, 74, 86, 108, 130, 151, 177, 203, 241, 258, 292],
	"H": [7, 14, 24, 34, 44, 58, 64, 84, 98, 119, 137, 155, 177, 194, 220],
}

var _passed: int = 0
var _failed: int = 0


func _initialize() -> void:
	_run_all()


func _run_all() -> void:
	await process_frame
	_test_inputs()
	_test_size_per_version()
	_test_function_patterns()
	_test_reference_matrices()
	_test_errors()
	_test_image()
	print("\n[tests] %d passed, %d failed" % [_passed, _failed])
	quit(0 if _failed == 0 else 1)


func _check(condition: bool, test_name: String) -> void:
	if condition:
		_passed += 1
		print("  ok   %s" % test_name)
	else:
		_failed += 1
		printerr("  FAIL %s" % test_name)


static func _rows_to_strings(matrix: Array) -> PackedStringArray:
	var out: PackedStringArray = PackedStringArray()
	for row: PackedByteArray in matrix:
		var line: String = ""
		for m: int in row:
			line += "1" if m != 0 else "0"
		out.append(line)
	return out


static func _is_square(matrix: Array) -> bool:
	for row: PackedByteArray in matrix:
		if row.size() != matrix.size():
			return false
	return not matrix.is_empty()


# ---- Tests ----

func _test_inputs() -> void:
	_check(_UTF8.to_utf8_buffer().size() == 22, "utf8 sample is 22 bytes (accent, 3- and 4-byte chars)")
	_check(_URL.length() > 100 and _URL.begins_with("https://"), "approval URL sample is a long https link")


func _test_size_per_version() -> void:
	for ecc: String in ["L", "M", "Q", "H"]:
		var caps: Array = _BYTE_CAPACITY[ecc]
		var all_ok: bool = true
		for v: int in range(1, 16):
			var cap: int = caps[v - 1]
			var at_cap: Array = InvoQr.encode("a".repeat(cap), ecc)
			if at_cap.size() != v * 4 + 17 or not _is_square(at_cap):
				all_ok = false
				printerr("    %s: %d bytes -> size %d, want %d" % [ecc, cap, at_cap.size(), v * 4 + 17])
			if v < 15:
				var over: Array = InvoQr.encode("a".repeat(cap + 1), ecc)
				if over.size() != (v + 1) * 4 + 17:
					all_ok = false
					printerr("    %s: %d bytes -> size %d, want %d" % [ecc, cap + 1, over.size(), (v + 1) * 4 + 17])
		_check(all_ok, "level %s: smallest version picked at every capacity edge (v1-v15)" % ecc)
	_check(InvoQr.encode("").size() == 21, "empty string encodes as version 1")


func _test_function_patterns() -> void:
	var finder: PackedStringArray = PackedStringArray([
		"1111111", "1000001", "1011101", "1011101", "1011101", "1000001", "1111111"])
	for text: String in ["A", _URL, "a".repeat(400)]:
		var m: Array = InvoQr.encode(text, "M")
		var s: PackedStringArray = _rows_to_strings(m)
		var n: int = s.size()
		var ok: bool = true
		for i: int in 7:
			ok = ok and s[i].substr(0, 7) == finder[i]
			ok = ok and s[i].substr(n - 7, 7) == finder[i]
			ok = ok and s[n - 7 + i].substr(0, 7) == finder[i]
		# Light separators around each finder.
		for i: int in 8:
			ok = ok and s[7][i] == "0" and s[i][7] == "0"
			ok = ok and s[7][n - 1 - i] == "0" and s[i][n - 8] == "0"
			ok = ok and s[n - 8][i] == "0" and s[n - 1 - i][7] == "0"
		_check(ok, "finder patterns + separators (%dx%d)" % [n, n])
		var timing: bool = true
		for i: int in range(8, n - 8):
			var want: String = "1" if i % 2 == 0 else "0"
			timing = timing and s[6][i] == want and s[i][6] == want
		_check(timing, "timing patterns (%dx%d)" % [n, n])
		_check(s[n - 8][8] == "1", "always-dark module (%dx%d)" % [n, n])


func _test_reference_matrices() -> void:
	for key: String in _REFERENCE:
		var parts: PackedStringArray = key.split("/")
		var got: PackedStringArray = _rows_to_strings(InvoQr.encode(_CASES[parts[0]], parts[1]))
		var want: PackedStringArray = PackedStringArray(_REFERENCE[key])
		_check(got == want, "matches reference matrix: %s (%dx%d)" % [key, want.size(), want.size()])
	_check(_rows_to_strings(InvoQr.encode("INVO", "q")) == PackedStringArray(_REFERENCE["short/Q"]),
			"lowercase ecc accepted")


func _test_errors() -> void:
	print("  (the next two push_error lines are expected)")
	_check(InvoQr.encode("a".repeat(413), "M").is_empty(), "too long for v15-M returns []")
	_check(InvoQr.encode("hi", "X").is_empty(), "unknown ecc level returns []")


func _test_image() -> void:
	var m: Array = InvoQr.encode("A")
	var img: Image = InvoQr.to_image(m, 3, 4)
	_check(img != null and img.get_width() == (21 + 8) * 3 and img.get_height() == img.get_width(),
			"to_image size = (modules + 2*quiet) * module_px")
	if img != null:
		_check(img.get_pixel(0, 0) == Color.WHITE and img.get_pixel(11, 11) == Color.WHITE,
				"quiet zone is light")
		_check(img.get_pixel(12, 12) == Color.BLACK and img.get_pixel(14, 14) == Color.BLACK,
				"top-left finder module is dark")
	var tinted: Image = InvoQr.to_image(m, 1, 0, Color.RED, Color.BLUE)
	_check(tinted != null and tinted.get_width() == 21 and tinted.get_pixel(0, 0) == Color.RED
			and tinted.get_pixel(7, 0) == Color.BLUE, "custom colours, no quiet zone")
	var tex: ImageTexture = InvoQr.to_texture(_URL)
	_check(tex != null and tex.get_width() == (49 + 8) * 6, "to_texture renders the approval URL (v8-M)")


