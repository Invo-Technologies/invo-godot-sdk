[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/invonetwork/dock/invo_dock.gd" id="1_dock"]

[node name="INVO" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_dock")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Scroll/VBox"]
layout_mode = 2
text = "INVO Network"
theme_override_font_sizes/font_size = 16

[node name="EnvLabel" type="Label" parent="Scroll/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
text = "Environment"

[node name="Environment" type="OptionButton" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="GameIdLabel" type="Label" parent="Scroll/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
text = "Game ID"

[node name="GameId" type="LineEdit" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "from the INVO console"

[node name="TokenLabel" type="Label" parent="Scroll/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
text = "Player-token endpoint (your backend)"

[node name="TokenEndpoint" type="LineEdit" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "https://your-backend.example/invo/token"

[node name="SecretLabel" type="Label" parent="Scroll/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
autowrap_mode = 2
text = "Sandbox game secret (dev only — never ships). Prefer the INVO_SANDBOX_SECRET env var: nothing persisted, nothing exportable."

[node name="SandboxSecret" type="LineEdit" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
secret = true
placeholder_text = "sandbox secret"

[node name="SaveButton" type="Button" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Save settings"

[node name="Sep" type="HSeparator" parent="Scroll/VBox"]
layout_mode = 2

[node name="TestEmailLabel" type="Label" parent="Scroll/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
text = "Sandbox test player email"

[node name="TestEmail" type="LineEdit" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "player@example.com"

[node name="TestButton" type="Button" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Test sandbox connection"

[node name="DocsButton" type="Button" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Open docs.invo.network"

[node name="Status" type="Label" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
